{
  "manifest_version": 3,
  "name": "Uniovi Virtual",
  "version": "0.2.0",
  "key": "",
  "description": "Tus próximos exámenes, entregas y avisos del Campus Virtual, y tus apuntes para tu IA.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://*.campusvirtual.uniovi.es/*",
    "https://campusvirtual.uniovi.es/*",
    "http://127.0.0.1:47823/*"
  ],
  "optional_host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.campusvirtual.uniovi.es/*",
        "https://campusvirtual.uniovi.es/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Uniovi Virtual",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
